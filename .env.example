# Direct Line secret for Microsoft Copilot Studio bot (keep secret - never commit .env file)
DIRECT_LINE_SECRET=your_direct_line_secret_here

# SerpApi key (serpapi.com) — optional, used by climate_news.py to pull
# additional Macedonian climate-news results from Google News search.
# Leave unset to skip this source (the other 21 RSS/Bluesky sources still work).
SERPAPI_KEY=your_serpapi_key_here

# Key required by GET /api/today_status/refresh?key=... — used by the
# cron/today_status_refresh cron job to force-refresh the live "today"
# forecast a few times a day. Generate any random string.
TODAY_REFRESH_KEY=your_today_refresh_key_here

# NASA FIRMS MAP_KEY — free, required by fire_collect.py to pull active-fire
# detections (MODIS + VIIRS). Get one at:
#   https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without it, the /fires page collection is skipped.
FIRMS_MAP_KEY=your_firms_map_key_here

# Global Forest Watch API key — free (valid 1 year), used by /api/fires/yearly
# to pull pre-aggregated yearly fire totals (x-api-key header). Create at:
#   https://data-api.globalforestwatch.org/  (POST /auth/apikey)
# Optional: if unset, yearly totals are computed from the local FIRMS CSVs instead.
GFW_API_KEY=your_gfw_api_key_here
