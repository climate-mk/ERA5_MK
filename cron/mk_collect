# si_climate nightly data refresh — runs at 03:30 each day
# Collects latest ERA5-Land data from Open-Meteo, restarts sidecar to reload in-memory data.
# Logs go to /var/log/si_collect.log

30 3 * * * www-data cd /opt/si_climate && COUNTRY=si venv/bin/python3 mk_collect.py >> /var/log/si_collect.log 2>&1 && systemctl restart si_climate >> /var/log/si_collect.log 2>&1
